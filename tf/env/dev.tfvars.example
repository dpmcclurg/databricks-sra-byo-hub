# Spoke layer - DEV environment (NON-PROD subscription). TEMPLATE - copy to dev.tfvars once the NON-PROD bootstrap and
# the DEV platform layer have run. Fill platform_cmk from `terraform output -raw spoke_tfvars_snippet` in the platform
# layer (DEV backend).
#
#   terraform init  -backend-config=env/dev.backend.hcl
#   terraform apply -var-file=env/dev.tfvars

subscription_id         = "<nonprod-subscription-id>"
location                = "eastus2"
resource_suffix         = "dbx-dev"
databricks_account_id   = "<databricks-account-id>"
databricks_metastore_id = "<metastore-id>"

# Account-level network objects in the existing hub, bound to the spoke workspace (from the hub/network team).
existing_ncc_id            = "<ncc-id>"            # Network Connectivity Config to bind the workspace to
existing_network_policy_id = "<network-policy-id>" # account network policy to apply to the workspace
# existing_ncc_name        = "<ncc-name>"          # optional; only used in private-endpoint approval descriptions

# Account-level group that OWNS the storage credential, external location, and catalog. Must already exist and should
# contain the workspace UAMI (id-<suffix>-workspace) so the pipeline keeps MANAGE across re-runs. See variables.tf.
catalog_owner_group = "<uc-owner-group>" # e.g. "unity-catalog-admins"

# Application (client) ID of the dedicated Databricks account service principal that runs the four account-admin-gated
# resources (metastore assignment, NCC binding/PE rule, workspace network option). The account-host databricks provider
# uses it with auth_type=azure-devops-oidc (via the pipeline's SYSTEM_ACCESSTOKEN) - no Azure identity, no secret. Set up
# ONCE per landing zone by a human account admin (see tf/account-admin-federation, then `terraform output
# account_admin_client_id`) and added to the account `admins` group. Leave empty for a local run as yourself (an account
# admin), where the provider falls back to ambient az-cli auth.
account_admin_client_id = "<account-admin-sp-client-id>"

# Auth type for the account-host databricks provider (used only when account_admin_client_id is set). A landing zone
# picks ONE CI, so set this to match it — or leave it unset:
#   - Azure DevOps: leave unset (defaults to "azure-devops-oidc").
#   - GitHub Actions: the reusable workflow sets "github-oidc" via TF_VAR_account_admin_auth_type, so unset works here too;
#     set it explicitly only if you prefer, or for a manual (non-CI) github-oidc run.
# If you do set it, it must match your CI: a -var-file value overrides the workflow's TF_VAR (var-file wins).
# account_admin_auth_type = "github-oidc"

# bootstrap output: environments.dev.spoke_resource_group
create_workspace_resource_group = false
existing_resource_group_name    = "rg-dbx-dev"
create_workspace_vnet           = true

# Required when create_workspace_vnet = true. Pick a /22 that does not overlap the hub or other spokes it peers to.
workspace_vnet = {
  cidr = "10.0.4.0/22"
}

cmk_enabled = true

# From: cd ../platform && terraform init -backend-config=env/dev.backend.hcl && terraform output -raw spoke_tfvars_snippet
platform_cmk = {
  key_vault_id            = "<dev-vault-id>"
  key_vault_uri           = "<dev-vault-uri>"
  managed_services_key_id = "<dev-managed-services-key-versioned-uri>"
  managed_disk_key_id     = "<dev-managed-disk-key-versioned-uri>"
  dbfs_root_key_name      = "kvk-dbx-dev-adb-dbfs"
  dbfs_root_key_version   = "<version>"
}

# Hub VNet for the dev spoke (matches bootstrap dev env hub_virtual_network_ids).
existing_hub_vnet = {
  vnet_id = "<dev-hub-vnet-id>"
}

# Create the spoke half of the hub peering. Set true ONLY if the provisioner has Network Contributor on the hub VNet
# (bootstrap grants the workspace UAMI that role when this env's hub_virtual_network_ids is set). If the network team
# owns both peering halves, set false — and omit hub_virtual_network_ids from the bootstrap env to match.
create_hub_peering = true

tags = {
  owner       = "you@example.com"
  environment = "dev"
}
